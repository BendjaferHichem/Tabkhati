# انسخ هذا الملف إلى .env وعدّل القيم حسب الحاجة
# cp .env.example .env

# مفتاح Groq API (احصل عليه من https://console.groq.com/keys)
GROQ_API_KEY=

# اسم النموذج المستخدم في Groq (اختياري، القيمة الافتراضية أدناه)
GROQ_MODEL=llama-3.3-70b-versatile

# مسار قاعدة البيانات (اختياري، يُستخدم مسار افتراضي إن تُرك فارغاً)
DATABASE_URL=

# منفذ تشغيل الخادم
PORT=3000
